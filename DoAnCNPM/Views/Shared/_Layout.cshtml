<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>

    <!-- Bootstrap 4.6 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        body {
            display: flex;
            min-height: 100vh;
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
        }

        .sidebar {
            width: 250px;
            background-color: #343a40;
            color: #fff;
            flex-shrink: 0;
            transition: all 0.3s ease;
        }

            .sidebar.collapsed {
                width: 70px;
            }

            .sidebar .profile {
                padding: 20px;
                text-align: center;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
                transition: all 0.3s ease;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
            }

                .sidebar .profile img {
                    width: 60px;
                    height: 60px;
                    object-fit: cover;
                    border-radius: 50%;
                    margin-bottom: 10px;
                    transition: all 0.3s ease;
                }

            .sidebar.collapsed .profile h6,
            .sidebar.collapsed .profile small {
                display: none;
            }


            .sidebar .nav-link {
                color: #ccc;
                padding: 12px 20px;
                transition: all 0.3s ease;
                white-space: nowrap;
            }

                .sidebar .nav-link i {
                    margin-right: 10px;
                    width: 20px;
                    text-align: center;
                }

            .sidebar.collapsed .nav-link {
                text-align: center;
                padding: 12px 0;
            }

                .sidebar.collapsed .nav-link i {
                    margin-right: 0;
                }

                .sidebar.collapsed .nav-link span {
                    display: none;
                }

            .sidebar .nav-link:hover,
            .sidebar .nav-link.active {
                background-color: #495057;
                color: #fff;
            }

        .toggle-btn {
            background-color: transparent;
            border: none;
            color: #fff;
            font-size: 20px;
            padding: 15px;
            outline: none;
        }

        .main-content {
            flex-grow: 1;
            padding: 30px;
            background-color: #f8f9fa;
            transition: margin-left 0.3s ease;
        }

        .tooltip-inner {
            background-color: #000;
            color: #fff;
            padding: 5px 10px;
            font-size: 12px;
        }
    </style>
</head>

<body>
    @{
        string username = "";
        string avatar = Url.Content("~/Content/img/user.png");
        string role = "";
        string roleName = "Không xác định";

        if (HttpContext.Current.Session["Username"] != null)
        {
            username = HttpContext.Current.Session["Username"].ToString();
            role = HttpContext.Current.Session["UserRole"]?.ToString();

            switch (role)
            {
                case "AD": roleName = "Quản lý"; break;
                case "NV": roleName = "Nhân viên"; break;
                case "TN": roleName = "Thu ngân"; break;
                case "Bep": roleName = "Nhân viên bếp"; break;
            }
        }
    }


        <!-- Sidebar -->
        <div id="sidebar" class="sidebar d-flex flex-column">
            <button class="toggle-btn" id="toggleSidebar" title="Thu gọn / Mở rộng">
                <i class="fas fa-bars"></i>
            </button>
            <div class="profile">
                <img src="@avatar" alt="Avatar" />
                <h6>@username</h6>
                <small>@roleName</small>
            </div>
            <nav class="nav flex-column mt-3">
                <a class="nav-link @((ViewContext.RouteData.Values["controller"].ToString() == "Menu") ? "active" : "")" href="@Url.Action("Menu", "Menu")" data-toggle="tooltip" title="Menu">
                    <i class="fas fa-utensils"></i><span> Menu</span>
                </a>
                <a class="nav-link @((ViewContext.RouteData.Values["controller"].ToString() == "OrderList") ? "active" : "")" href="@Url.Action("OrderList", "OrderList")" data-toggle="tooltip" title="Order List">
                    <i class="fas fa-list"></i><span> Order List</span>
                </a>
                <a class="nav-link @((ViewContext.RouteData.Values["controller"].ToString() == "OrderCardList") ? "active" : "")" href="@Url.Action("OrderCardList", "OrderCardList")" data-toggle="tooltip" title="Card Orders">
                    <i class="fas fa-th"></i><span> Card Orders</span>
                </a>
                @if (role == "AD")
                {
                    <a class="nav-link @((ViewContext.RouteData.Values["controller"].ToString() == "Report") ? "active" : "")" href="@Url.Action("Report", "Report")" data-toggle="tooltip" title="Report">
                        <i class="fas fa-chart-bar"></i><span> Report</span>
                    </a>
                }
                <a class="nav-link @((ViewContext.RouteData.Values["controller"].ToString() == "Table") ? "active" : "")" href="@Url.Action("TableList", "Table")" data-toggle="tooltip" title="Tables">
                    <i class="fas fa-chair"></i><span> Tables</span>
                </a>
                <a class="nav-link @((ViewContext.RouteData.Values["controller"].ToString() == "Bill") ? "active" : "")" href="@Url.Action("Bill", "Bill")" data-toggle="tooltip" title="Bills">
                    <i class="fas fa-receipt"></i><span> Bills</span>
                </a>
                <a class="nav-link mt-4" href="@Url.Action("ProfileInfo", "Login")" data-toggle="tooltip" title="Thông tin tài khoản">
                    <i class="fas fa-user-circle text-primary"></i><span> Tài khoản</span>
                </a>
                <a class="nav-link" href="@Url.Action("Logout", "Login")" data-toggle="tooltip" title="Đăng xuất">
                    <i class="fas fa-sign-out-alt text-danger"></i><span> Logout</span>
                </a>
            </nav>
        </div>

        <!-- Main content -->
        <div class="main-content">
            @RenderBody()
        </div>

        @RenderSection("scripts", required: false)

        <!-- JS -->
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

        <script>
            $(document).ready(function () {
                $('[data-toggle="tooltip"]').tooltip();

                $('#toggleSidebar').click(function () {
                    $('#sidebar').toggleClass('collapsed');
                });
            });
        </script>
</body>
</html>
