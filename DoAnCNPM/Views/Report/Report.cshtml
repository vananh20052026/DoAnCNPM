@model QuanAn.Models.ViewModel.ReportVM
@using Newtonsoft.Json

@{
    ViewBag.Title = "Báo cáo tổng hợp";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

<style>
     .main-content {
     background: url('@Url.Content("~/Content/img/fullban.jpg")') no-repeat center center fixed;
     background-size: cover;
     background-attachment: fixed;
     padding: 30px;
     }
    .card .card-body {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .card .card-title i {
        font-size: 1.5rem;
    }

    .container {
        background-color: rgba(255, 255, 255, 0.3); /* trong mờ hơn */
        backdrop-filter: blur(10px); /* hiệu ứng mờ */
        -webkit-backdrop-filter: blur(10px); /* Safari */
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    html {
        scroll-behavior: smooth;
    }

    .nav-pills .nav-link.active {
        background-color: #0d6efd;
        color: white;
        font-weight: bold;
        border-radius: 5px;
    }

    .section {
        padding-top: 60px;
        margin-bottom: 50px;
    }

    .card {
        border: none;
        box-shadow: 0 0 10px rgba(0,0,0,0.05);
        text-align: center;
    }

    .card-header {
        font-size: 1.25rem;
        font-weight: bold;
        color: white;
        border-bottom: none;
        text-align: center;
    }

    .table th,
    .table td {
        text-align: center;
        vertical-align: middle !important;
    }

    .revenue-header {
        background-color: rgba(54, 162, 235, 0.8);
    }

    .top-sold-header {
        background-color: rgba(255, 99, 132, 0.8);
    }

    .top-profit-header {
        background-color: rgba(255, 206, 86, 0.8);
    }

    .order-list-header {
        background-color: #198754;
        color: white;
        font-weight: bold;
        font-size: 1.25rem;
        border-bottom: none;
    }

    .item-list-header {
        background-color: #0d6efd;
        color: white;
        font-weight: bold;
        font-size: 1.25rem;
        border-bottom: none;
    }

    .floating-menu {
        position: sticky;
        top: 80px;
        z-index: 999;
        background: white;
        border-bottom: 1px solid #eee;
        padding: 10px 0;
        margin-bottom: 20px;
    }

        .floating-menu a {
            margin: 0 10px;
            padding: 6px 12px;
            border-radius: 5px;
            font-weight: 500;
            color: #0d6efd;
            transition: background-color 0.2s;
        }

            .floating-menu a:hover {
                background-color: #e9f0ff;
                text-decoration: none;
            }
</style>

<div class="container py-4">
    <div class="row">
        <div class="container py-4">
            <h2 class="mb-4 text-center">📊 Báo cáo tổng hợp đơn hàng và món ăn</h2>

            <!-- Floating navigation -->
            <div class="text-center floating-menu">
                <a href="#revenue"><i class="fa-solid fa-chart-line me-1"></i> Doanh thu</a>
                <a href="#top-sold"><i class="fa-solid fa-fire me-1"></i> Món bán chạy</a>
                <a href="#top-profit"><i class="fa-solid fa-money-bill-trend-up me-1"></i> Lợi nhuận</a>
                <a href="#orders"><i class="fa-solid fa-receipt me-1"></i> Đơn hàng</a>
                <a href="#items"><i class="fa-solid fa-bowl-rice me-1"></i> Món ăn</a>
            </div>

            <!-- Tổng quan -->
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card text-white bg-primary mb-3">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fa-solid fa-coins me-2"></i>Doanh thu</h5>
                            <p class="fs-4 fw-bold">@Model.TotalRevenue.ToString("N0") đ</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-success text-white mb-3">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fa-solid fa-receipt me-2"></i>Tổng đơn</h5>
                            <p class="fs-4 fw-bold">@Model.TotalOrderCount</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-warning text-dark mb-3">
                        <div class="card-body">
                            <h5 class="card-title"><i class="fa-solid fa-bowl-food me-2"></i>Món đã bán</h5>
                            <p class="fs-4 fw-bold">@Model.TotalFoodCount</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Doanh thu -->
            <div id="revenue" class="section">
                <div class="card mb-4">
                    <div class="card-header revenue-header "><i class="fa-solid fa-chart-column me-2"></i>Doanh thu theo tháng</div>
                    <div class="card-body">
                        <canvas id="revenueChart" height="300"></canvas>
                    </div>
                </div>
            </div>

            <!-- Top bán chạy -->
            <div id="top-sold" class="section">
                <div class="card mb-4">
                    <div class="card-header top-sold-header"><i class="fa-solid fa-fire me-2"></i>Top 5 món bán chạy nhất</div>
                    <div class="card-body">
                        <canvas id="topOrderedChart" height="300"></canvas>
                    </div>
                </div>
            </div>

            <!-- Top lợi nhuận -->
            <div id="top-profit" class="section">
                <div class="card mb-4">
                    <div class="card-header top-profit-header"><i class="fa-solid fa-money-bill-trend-up me-2"></i>Top 5 món lợi nhuận cao nhất</div>
                    <div class="card-body">
                        <canvas id="topProfitChart" height="300"></canvas>
                    </div>
                </div>
            </div>

            <!-- Danh sách đơn -->
            <div id="orders" class="section">
                <div class="card mb-4">
                    <div class="card-header order-list-header"><i class="fa-solid fa-clipboard-list me-2"></i>Danh sách đơn hàng</div>
                    <div class="card-body table-responsive">
                        <table class="table table-hover table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã đơn</th>
                                    <th>Bàn</th>
                                    <th>Nhân viên</th>
                                    <th>Ngày tạo</th>
                                    <th>Trạng thái</th>
                                    <th>Tổng tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.Orders)
                                {
                                    <tr>
                                        <td>@order.OrderID</td>
                                        <td>@order.TableName</td>
                                        <td>@order.Staff</td>
                                        <td>@order.CreatedTime</td>
                                        <td>
                                            <span class="badge
                                                @(order.Status == "Hoàn tất" ? "bg-success" :
                                                  order.Status == "Đang xử lý" ? "bg-warning text-dark" :
                                                  order.Status == "Chưa làm" ? "bg-secondary" : "bg-info")">
                                                @order.Status
                                            </span>
                                        </td>
                                        <td>@order.TotalFinal đ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Thống kê món ăn -->
            <div id="items" class="section">
                <div class="card mb-4">
                    <div class="card-header item-list-header"><i class="fa-solid fa-bowl-food me-2"></i>Thống kê món ăn đã bán</div>
                    <div class="card-body table-responsive">
                        <table class="table table-striped table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã đơn</th>
                                    <th>Món ăn</th>
                                    <th>Số lượng</th>
                                    <th>Đơn giá</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>@item.OrderID</td>
                                        <td>@item.FoodName</td>
                                        <td>@item.Quantity</td>
                                        <td>@item.UnitPrice.ToString("N0") đ</td>
                                        <td>
                                            <span class="badge
                                                @(item.Status == "Hoàn tất" ? "bg-success" :
                                                  item.Status == "Chưa làm" ? "bg-secondary" : "bg-warning text-dark")">
                                                @item.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const formatVND = (val) => val.toLocaleString('vi-VN') + ' đ';

        // ==== 1. Biểu đồ Doanh thu theo tháng ====
        new Chart(document.getElementById('revenueChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(JsonConvert.SerializeObject(Model.MonthlyRevenues.Select(x => x.Month))),
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: @Html.Raw(JsonConvert.SerializeObject(Model.MonthlyRevenues.Select(x => x.TotalRevenue))),
                    backgroundColor: function(context) {
                        const chart = context.chart;
                        const {ctx, chartArea} = chart;
                        if (!chartArea) return null;

                        const gradient = ctx.createLinearGradient(0, chartArea.bottom, 0, chartArea.top);
                        gradient.addColorStop(0, 'rgba(54, 162, 235, 0.2)');
                        gradient.addColorStop(1, 'rgba(54, 162, 235, 0.8)');
                        return gradient;
                    },
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1,
                    borderRadius: 4,
                    barThickness: 40
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: ctx => ' ' + ctx.dataset.label + ': ' + formatVND(ctx.parsed.y)
                        }
                    },
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: val => formatVND(val)
                        }
                    }
                },
                animation: {
                    duration: 1200,
                    easing: 'easeOutCubic'
                }
            }
        });

        // ==== 2. Biểu đồ Top 5 món bán chạy ====
        new Chart(document.getElementById('topOrderedChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(JsonConvert.SerializeObject(Model.TopOrderedFoods.Select(x => x.FoodName))),
                datasets: [{
                    label: 'Số lượng bán',
                    data: @Html.Raw(JsonConvert.SerializeObject(Model.TopOrderedFoods.Select(x => x.TotalQuantity))),
                    backgroundColor: 'rgba(255, 99, 132, 0.6)',
                    borderColor: 'rgba(255, 99, 132, 1)',
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: ctx => ' Đã bán: ' + ctx.parsed.x + ' món'
                        }
                    },
                    legend: { display: false }
                },
                scales: {
                    x: { beginAtZero: true }
                },
                animation: {
                    duration: 1000,
                    easing: 'easeOutBack'
                }
            }
        });

        // ==== 3. Biểu đồ Top 5 món lợi nhuận cao ====
        new Chart(document.getElementById('topProfitChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(JsonConvert.SerializeObject(Model.TopProfitFoods.Select(x => x.FoodName))),
                datasets: [{
                    label: 'Lợi nhuận (VNĐ)',
                    data: @Html.Raw(JsonConvert.SerializeObject(Model.TopProfitFoods.Select(x => x.TotalProfit))),
                    backgroundColor: function(context) {
                        const chart = context.chart;
                        const {ctx, chartArea} = chart;
                        if (!chartArea) return null;

                        const gradient = ctx.createLinearGradient(0, chartArea.bottom, 0, chartArea.top);
                        gradient.addColorStop(0, 'rgba(255, 206, 86, 0.2)');
                        gradient.addColorStop(1, 'rgba(255, 206, 86, 0.8)');
                        return gradient;
                    },
                    borderColor: 'rgba(255, 206, 86, 1)',
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: ctx => ' Lợi nhuận: ' + formatVND(ctx.parsed.x)
                        }
                    },
                    legend: { display: false }
                },
                scales: {
                    x: {
                        beginAtZero: true,
                        ticks: {
                            callback: val => formatVND(val)
                        }
                    }
                },
                animation: {
                    duration: 1200,
                    easing: 'easeOutQuart'
                }
            }
        });
    </script>
    <script>
        const scrollSpy = new bootstrap.ScrollSpy(document.body, {
            target: '#reportMenu',
            offset: 80
        });
    </script>
}
